# Copy to .env and fill in ONE provider key. .env is gitignored — never commit a key.
# Nothing in this file may be copied into models.py, resolver.py, validators.py,
# fixtures, or the data/ directory.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
# With an OpenAI-compatible gateway passthrough (model=openai/<name>) litellm resolves
# the credential from OPENAI_API_KEY. Set it to the GATEWAY's virtual key, i.e. the
# same value as LITELLM_API_KEY. Leave empty when using SDK mode.
OPENAI_API_KEY=

# --- Google ---
GEMINI_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- Selection -------------------------------------------------------------
# Backend: "litellm" (default, provider-portable) or "anthropic" (direct SDK).
LLM_BACKEND=litellm


# Optional. Leave unset for SDK mode — do not set a URL unless you really want the
# proxy. The proxy is not needed and adds a hidden dependency to the boundary.
LITELLM_API_BASE=
LITELLM_API_KEY=

LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
